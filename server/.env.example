# URL do PostgreSQL hospedado no Neon. Use a URL com pooler fornecida pelo Neon.
DATABASE_URL=postgresql://<USUARIO>:<SENHA>@<HOST-POOLER-NEON>/<BANCO>?sslmode=require

# Chave de 32 bytes, codificada em base64. Gere com:
# node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
WHATSAPP_AUTH_ENCRYPTION_KEY=

# URL do webhook de producao ativado no n8n. O nome n8n so funciona na rede interna.
ASSISTANT_WORKFLOW_URL=http://n8n:5678/webhook/jarvis-assistant
ASSISTANT_WORKFLOW_KEY=troque-por-um-segredo-longo-e-unico

# Opcional: a porta e interna ao Docker; nao sera publicada no host.
PORT=3000

# Necessarios apenas se voce for executar o seed manualmente.
SEED_PROFILE_NAME=
SEED_PROFILE_TOKEN=
SEED_PROFILE_JID=
SEED_PROFILE_ACTIVE=true
