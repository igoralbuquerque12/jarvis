PORT=3000

# Postgres do Jarvis (servico `postgres` do compose da raiz, pgvector). Use a mesma
# senha de JARVIS_DB_PASSWORD do .env da raiz. No Docker o compose sobrescreve
# esta URL apontando para postgres:5432; localhost:5432 vale so para o dev local.
DATABASE_URL=postgresql://jarvis:<JARVIS_DB_PASSWORD>@localhost:5432/jarvis

BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=

REDIS_URL=redis://localhost:6379

WEB_ORIGIN=http://localhost:5173

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

SEED_PROFILE_NAME=
SEED_PROFILE_TOKEN=
SEED_PROFILE_JID=
SEED_PROFILE_ACTIVE=true


WHATSAPP_AUTH_ENCRYPTION_KEY=base64!!!
WHATSAPP_ADMIN_API_KEY=troque-por-uma-chave-secreta-administrativa
HEALTH_CHECK_AUTH_ENCRYPTION_KEY=base64!!!

ASSISTANT_WORKFLOW_URL=http://n8n:5678/webhook/jarvis-assistant
ASSISTANT_WORKFLOW_KEY=troque-por-um-segredo-longo-e-unico

# Securo (gestor financeiro). No Docker o compose sobrescreve a URL para
# http://securo-backend:8000; use localhost:8000 apenas no dev local.
SECURO_API_URL=http://localhost:8000
SECURO_ADMIN_EMAIL=admin@jarvis.internal
SECURO_ADMIN_PASSWORD=troque-por-uma-senha-forte
SECURO_PROVISION_SECRET=troque-por-um-segredo-longo-e-unico

SEED_PROFILE_NAME=
SEED_PROFILE_TOKEN=
SEED_PROFILE_JID=
SEED_PROFILE_ACTIVE=true

# IA, uma variavel por finalidade (AI_PROVIDER foi renomeada e derruba o boot):
# - AI_EXTRACTION_PROVIDER (openai | groq): gera nome e descricao das bases.
# - AI_EMBEDDING_PROVIDER (openai): gera os embeddings do RAG das bases.
# OPENAI_API_KEY e sempre obrigatoria (embeddings); GROQ_API_KEY so com
# AI_EXTRACTION_PROVIDER=groq. A falta da chave derruba o boot.
AI_EXTRACTION_PROVIDER=openai
AI_EMBEDDING_PROVIDER=openai

OPENAI_API_KEY=
GROQ_API_KEY=
