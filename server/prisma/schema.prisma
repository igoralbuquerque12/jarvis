generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model WhatsappAuth {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("whatsapp_auth")
}

model Profile {
  id             String       @id @default(uuid()) @db.Uuid
  name           String
  token          String
  jid            String       @unique()
  about          String       @default("")
  active         Boolean      @default(true)
  subscriptionId String       @db.Uuid
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([subscriptionId])
  @@map("profiles")
}

model Subscription {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  price     Decimal   @db.Decimal(10, 2)
  limit     Int
  profiles  Profile[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("subscriptions")
}

model Message {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String
  content   String
  type      MessageType
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([userId])
  @@map("messages")
}

enum MessageType {
  user
  AI
}
