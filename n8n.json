    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Runs after \"Get context\" and \"Get tools\".\n//\n// Output:\n//   systemPrompt → AI Agent › Options › System Message  ({{ $json.systemPrompt }})\n//   userPrompt   → AI Agent › Prompt (Define below)      ({{ $json.userPrompt }})\n//   runId        → used by the executar_ferramenta tool  ({{ $('Build prompt').item.json.runId }})\n//\n// The system prompt carries instructions, the tool reference of the user's\n// plan and the context of the day; everything the user or Jarvis said goes\n// to the user prompt as data inside tags.\n\nconst context = $('Get context').item.json;\nconst toolset = $('Get tools').item.json;\nconst runId = $('Config').item.json.runId;\n\n// Angle brackets in user content are neutralised so a message can never\n// close or open one of the context tags below (prompt-injection guard).\nconst escapeTags = (value) =>\n  String(value ?? '').replace(/</g, '‹').replace(/>/g, '›');\n\nconst messages = [...(context.lastMessages ?? [])];\nconst ordered = messages.every((message) => message.createdAt)\n  ? messages.sort((a, b) => new Date(a.createdAt) - new Date(b.createdAt))\n  : messages.reverse(); // backend sends newest first\n\nconst history = ordered\n  .map((message) => {\n    const author = message.type === 'AI' ? 'jarvis' : 'usuario';\n    return `<mensagem autor=\"${author}\">${escapeTags(message.content)}</mensagem>`;\n  })\n  .join('\\n');\n\nconst timezone = context.timezone || 'America/Sao_Paulo';\nconst fallbackNow = new Date();\nconst nowIso = context.now || fallbackNow.toISOString();\nconst nowHuman =\n  context.nowHuman ||\n  new Intl.DateTimeFormat('pt-BR', {\n    timeZone: timezone,\n    dateStyle: 'full',\n    timeStyle: 'short',\n  }).format(fallbackNow);\n\nconst profileContext =\n  (context.profileContext || '').trim() ||\n  'Nenhuma informação adicional sobre o usuário.';\n\nconst knowledge = (Array.isArray(context.knowledge) ? context.knowledge : []).map(\n  ({ id, name, description }) => ({ id, name, description }),\n);\n\nconst systemPrompt = [\n  context.directive ?? '',\n  '',\n  toolset.reference ?? '',\n  '',\n  '# Contexto desta conversa',\n  '',\n  '<data_e_hora_atual>',\n  `${nowHuman} (${nowIso}, fuso ${timezone})`,\n  '</data_e_hora_atual>',\n  '',\n  '<perfil_do_usuario>',\n  escapeTags(profileContext),\n  '</perfil_do_usuario>',\n  '',\n  '<bases_de_conhecimento>',\n  escapeTags(JSON.stringify(knowledge)),\n  '</bases_de_conhecimento>',\n].join('\\n');\n\nconst currentMessage = String(context.currentMessage ?? '');\n\nconst userPrompt = [\n  '<historico_recente>',\n  history || 'Nenhuma mensagem anterior.',\n  '</historico_recente>',\n  '',\n  '<mensagem_atual>',\n  escapeTags(currentMessage),\n  '</mensagem_atual>',\n].join('\\n');\n\nreturn {\n  json: {\n    runId,\n    hasMessage: currentMessage.trim().length > 0,\n    systemPrompt,\n    userPrompt,\n  },\n};"
      },
      "type": "n8n-nodes-base.code",
